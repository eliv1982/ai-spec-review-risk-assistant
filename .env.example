OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=sqlite:///./data/app.db
BACKEND_CORS_ORIGINS=http://localhost:5173

# Локальная публикация Docker-приложения только на loopback-интерфейсе.
APP_PORT=8080

# Параметры существующего Traefik на VPS. Замените example.com на свой домен.
# APP_HOST — основной аутентифицированный хост приложения (Basic Auth, /api, SQLite).
APP_HOST=app.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Необязательно: ссылка на middleware, уже определённый в Traefik, например app-auth@file.
# Используется только вместе с docker-compose.traefik-auth.yml.
TRAEFIK_MIDDLEWARES=

# PUBLIC_HOST — хост публичного статического лендинга (docker-compose.portfolio.yml).
# Без Basic Auth и без доступа к backend/API.
PUBLIC_HOST=spec-review.elivcloud.org

# APP_ALIAS_HOST используется только на этапе поэтапной миграции хоста
# (docker-compose.private-alias.yml): временный второй аутентифицированный
# хост для уже существующего frontend, наряду с APP_HOST. Эта переменная не
# означает, что миграция уже выполнена — только что overlay для неё
# подготовлен.
APP_ALIAS_HOST=app.spec-review.elivcloud.org
